    chown root root /data/vendor/camera/28.png
    restorecon /data/vendor/camera/28.png

    copy /vendor/etc/camera/72.png /data/vendor/camera/72.png
    chmod 0644 /data/vendor/camera/72.png
    chown root root /data/vendor/camera/72.png
    restorecon /data/vendor/camera/72.png

    copy /vendor/etc/camera/73.png /data/vendor/camera/73.png
    chmod 0644 /data/vendor/camera/73.png
    chown root root /data/vendor/camera/73.png
    restorecon /data/vendor/camera/73.png
