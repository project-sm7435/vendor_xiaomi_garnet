on post-fs-data
    mkdir /data/vendor/camera 0755 root root

    copy /vendor/etc/camera/2.png /data/vendor/camera/2.png
    chmod 0644 /data/vendor/camera/2.png
    chown root root /data/vendor/camera/2.png
    restorecon /data/vendor/camera/2.png

    copy /vendor/etc/camera/3.png /data/vendor/camera/3.png
    chmod 0644 /data/vendor/camera/3.png
    chown root root /data/vendor/camera/3.png
    restorecon /data/vendor/camera/3.png

    copy /vendor/etc/camera/4.png /data/vendor/camera/4.png
