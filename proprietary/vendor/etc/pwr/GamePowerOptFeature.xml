<Feature>
   <Name>GamePowerOptFeature</Name>
   <Libname>libgamepoweroptfeature.so</Libname>
   <Configs target = "parrot">
        <!-- FPS threshold values in the order: Increase, Aggressive Increase, Decrease, Target FPS Delta-->
        <FPS_30_THRESHOLD>0.2, 0.4, 0.8, 0.0</FPS_30_THRESHOLD>
        <FPS_35_THRESHOLD>0.2, 0.4, 0.8, 0.0</FPS_35_THRESHOLD>
        <FPS_40_THRESHOLD>0.2, 0.4, 0.8, 0.0</FPS_40_THRESHOLD>
        <FPS_60_THRESHOLD>0.2, 0.4, 2.0, 1</FPS_60_THRESHOLD>
        <FPS_90_THRESHOLD>0.2, 0.4, 2.0, 1</FPS_90_THRESHOLD>
        <FPS_120_THRESHOLD>0.2, 0.4, 2.0, 1</FPS_120_THRESHOLD>
        <FPS_MAX_THRESHOLD>120</FPS_MAX_THRESHOLD>
        <!-- Parameters: kp, ki, kd, iLimit, outputLimit, dt (fre unit kHz)-->
        <PID_Parameters_Up>15, 4, 8, 50, 500, 0.5</PID_Parameters_Up>
        <PID_Parameters_Down>2, 1, 1, 10, 100, 0.5</PID_Parameters_Down>
        <SAMPLE_CALL_INTERVAL_MSEC>50</SAMPLE_CALL_INTERVAL_MSEC>
        <MAX_SAMPLE_NUM>6</MAX_SAMPLE_NUM>
        <FPS_STABLE_CNT>10</FPS_STABLE_CNT>
        <Freq_Drop_Bottom_ThresholdRatio>5</Freq_Drop_Bottom_ThresholdRatio>
        <MIN_MAX_CAP_RANGE_DOWN>1</MIN_MAX_CAP_RANGE_DOWN>
        <MIN_MAX_CAP_RANGE_UP>6</MIN_MAX_CAP_RANGE_UP>
        <Algo_Engine>Algo_PID</Algo_Engine>
    </Configs>
   <Configs>
        <!-- FPS threshold values in the order: Increase, Aggressive Increase, Decrease, Target FPS Delta-->
        <FPS_30_THRESHOLD>0.2, 0.4, 0.8, 0.0</FPS_30_THRESHOLD>
